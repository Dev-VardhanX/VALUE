# Example keystore configuration for release builds.
# Copy this file to "keystore.properties" (which is ignored by git)
# and fill in your actual signing credentials.
#
# DO NOT commit keystore.properties or keystore files to version control.

storePassword=your_store_password
keyPassword=your_key_password
keyAlias=your_key_alias
storeFile=path/to/your.keystore
